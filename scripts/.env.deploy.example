# Copie ce fichier en scripts/.env.deploy et remplis les valeurs.
# scripts/.env.deploy doit être ajouté à .gitignore — NE JAMAIS COMMITER ce fichier rempli.
#
# Convex production deploy key (dashboard.convex.dev > Settings > Deploy Keys)
CONVEX_DEPLOY_KEY=

# Clerk production
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# In-App Purchase (App Store Connect > App Information > App-Specific Shared Secret)
IAP_APPLE_SHARED_SECRET=

# Push Notifications APNs (optionnel - laisser vide si EAS gère la clé)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.okatech.lamap
# APNS_P8_PATH=/chemin/vers/AuthKey_XXXXXXXXXX.p8
